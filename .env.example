# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- TMDB ---
TMDB_API_KEY=your_tmdb_v3_api_key
TMDB_READ_ACCESS_TOKEN=your_tmdb_v4_read_access_token

# --- RapidAPI: OTT Details (GoX-ai) ---
RAPIDAPI_KEY=your_rapidapi_key
RAPIDAPI_HOST=ott-details.p.rapidapi.com

# --- Supabase (new publishable/secret key format) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Personal access token for the Supabase Management API/CLI (not a project
# API key) -- only needed for scripted migrations or CLI login, never used
# by the running app itself. Keep this out of any deploy platform's env
# vars; it's broader than this one project.
SUPABASE_ACCESS_TOKEN=sbp_...

# Base URL of the deployed app, used to build the join link embedded in the QR code.
NEXT_PUBLIC_APP_URL=http://localhost:3000
